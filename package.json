{
  "name": "financy",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "dev": "pnpm --parallel --recursive run dev",
    "dev:backend": "pnpm --filter @financy/backend dev",
    "build": "pnpm --recursive run build",
    "typecheck": "pnpm --recursive run typecheck",
    "db:up": "docker compose --env-file apps/backend/.env up -d --wait",
    "db:down": "docker compose --env-file apps/backend/.env down",
    "test": "pnpm --recursive run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexandreAraujo01/Financy.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/AlexandreAraujo01/Financy/issues"
  },
  "homepage": "https://github.com/AlexandreAraujo01/Financy#readme"
}
